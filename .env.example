# ---------------------------------------------------------------------------
# ORBIT SOCIAL — environment
# Everything works with zero keys (DRIVER=mock). Fill these in to go live.
# ---------------------------------------------------------------------------

# mock  = deterministic simulated platform data (default, no keys needed)
# live  = real HTTP calls to the platform APIs using the tokens below
PLATFORM_DRIVER=mock

# --- Supabase (Auth, PostgreSQL DB, Storage, Realtime) ---------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Dashboard → Project Settings → API → service_role (secret)
# Required for staff provisioning (npm run provision-users) and background jobs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Supabase PostgreSQL Connection String (Direct or Pooled)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Transaction pooler format (port 6543, recommended for serverless/Next.js):
# postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# --- Auth & Domain Configuration -------------------------------------------
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GLENTREE_EMAIL_DOMAIN=glentree.com

# --- AI provider (captions, reply drafting, strategy narratives) ------------
# Optional. Without a key the AI engines still run — they fall back to the
# deterministic rule/statistics engine and just lose the natural-language polish.
#
# Which provider answers:
#   auto (default) = first one below that has a key, falling through on failure
#   groq | gemini | anthropic = pin exactly one
AI_PROVIDER=auto

# Groq — fastest of the three. console.groq.com/keys
# Model IDs are retired often; check console.groq.com/docs/models if calls stop.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic — console.anthropic.com/settings/keys


# --- Meta (Instagram + Facebook Pages + Meta Ads) ---------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000

# --- Google Ads -------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Business Profile (reviews, local insights) ----------------------
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Other networks ---------------------------------------------------------
LINKEDIN_ORG_URN=

# --- Public base URL --------------------------------------------------------
# The address this app is reachable at from the public internet. Platforms fetch
# media by URL (Instagram containers, TikTok PULL_FROM_URL, LinkedIn/X uploads),
# so a localhost address will not work for live publishing — use a tunnel in
# development or the real deployment origin in production.
PUBLIC_BASE_URL=

# --- Worker -----------------------------------------------------------------
# Shared secret so only your cron/worker can trigger the publish tick.
WORKER_SECRET=CHANGE-ME-openssl-rand-hex-32

# --- WhatsApp Business (Cloud API) ------------------------------------------
# Webhook: point Meta at POST /api/webhooks/whatsapp and use the verify token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=CHANGE-ME-any-random-string

# --- n8n automation ---------------------------------------------------------
# Shared secret n8n presents as the `x-n8n-secret` header on
# POST /api/webhooks/n8n (create_lead / book_appointment / send_message).
# That path is exempt from the session gate, so this secret is the only thing
# authenticating it — leave it unset and the endpoint refuses every request
# (503) rather than accepting unauthenticated writes.
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Outbound events are configured at runtime, not here: register subscriber URLs
# and their per-subscriber signing secrets through POST /api/integrations/n8n
# (workflows.manage). Deliveries are signed HMAC-SHA256 over the raw body and
# sent as `x-orbit-signature: sha256=<hex>`.

# --- OAuth client credentials for the Connect flow --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

