# =============================================================================
# GLENTREE — ENVIRONMENT
# =============================================================================
#
# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
#
# HOW TO READ THIS FILE
#   [REQUIRED]  the app will not start, or the feature throws, without it
#   [NEEDED]    required only if you use that feature
#   [OPTIONAL]  has a sensible default; set it to override
#
# DEPLOYING TO VERCEL
#   Vercel does not read this file. Paste each value into
#   Project → Settings → Environment Variables, for Production AND Preview.
#   Anything starting NEXT_PUBLIC_ is sent to the browser — never put a secret
#   behind that prefix.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. THE APP ITSELF
# -----------------------------------------------------------------------------

# [REQUIRED on Vercel] Public HTTPS origin, no trailing slash. Used to build
# links in outbound messages and to verify webhook callbacks. Locally this is
# http://localhost:4321; in production it must be the real domain, because
# WhatsApp will refuse to fetch a brochure from a URL it cannot reach.
NEXT_PUBLIC_APP_URL=http://localhost:4321


# -----------------------------------------------------------------------------
# 2. DATABASE — Supabase
#    Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# [REQUIRED] The CRM, conversations, leads and insights all live here.
OSF_SUPABASE_URL=https://<project-ref>.supabase.co

# [REQUIRED] service_role key. Server-only, bypasses row-level security.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
OSF_SUPABASE_SERVICE_ROLE_KEY=

# [NEEDED] anon key — safe for the browser, used by the sign-in form.
NEXT_PUBLIC_OSF_SUPABASE_ANON_KEY=

# [NEEDED] The staff sign-in and role system reads these. On a single-project
# install they are the same values as the two above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [NEEDED] Direct Postgres connection. Only the setup scripts and one-off SQL
# use it; the running app never does. Dashboard -> Project Settings -> Database
# -> Connection string -> URI. If your network has no IPv6 route, take the
# Session pooler string on that same page instead of the direct one.
DATABASE_URL=

# -----------------------------------------------------------------------------
# SETTING UP A BRAND-NEW SUPABASE PROJECT
#
#   1. supabase.com -> New project. Pick a region near your users
#      (ap-south-1 / Mumbai for India) and save the database password you set:
#      it appears exactly once and goes into DATABASE_URL below.
#
#   2. SQL Editor -> New query -> paste the whole of `supabase/schema.sql`
#      -> Run. That builds every table, the permission rules, all row-level
#      security and the four private storage buckets. It is safe to re-run.
#
#   3. Project Settings -> API. Copy:
#        Project URL   -> NEXT_PUBLIC_SUPABASE_URL and OSF_SUPABASE_URL
#        anon key      -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#                         and NEXT_PUBLIC_OSF_SUPABASE_ANON_KEY
#        service_role  -> SUPABASE_SERVICE_ROLE_KEY
#                         and OSF_SUPABASE_SERVICE_ROLE_KEY
#
#   4. Project Settings -> Database -> Connection string -> DATABASE_URL.
#
#   5. Create the first administrator:  npm run provision-users
#      After that, staff are added from Settings -> Users and roles.
#
#   6. Authentication -> URL Configuration -> add your site URL and
#      `<your-site>/api/connections/callback` to the redirect allow-list,
#      or e-mail sign-in links will bounce.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# 3. THE AI THAT ANSWERS CUSTOMERS
# -----------------------------------------------------------------------------

# Which provider answers. `auto` tries each in order until one has a key.
# auto | groq | gemini | anthropic
AI_PROVIDER=auto
LLM_PROVIDER=groq

# [REQUIRED if LLM_PROVIDER=groq] console.groq.com/keys
# The free tier caps each key at 8,000 tokens/minute, which is enough to demo
# and not enough for live traffic.
GROQ_API_KEY=

# [OPTIONAL] Extra Groq keys, comma-separated. When the primary hits its rate
# limit the agent rotates to the next one instead of dropping the reply.
GROQ_API_KEY_FALLBACK=

GROQ_MODEL=openai/gpt-oss-120b
# Transcribes customers' WhatsApp voice notes.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# [NEEDED if you use them] The other two providers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# How hard the agent thinks before replying: low | medium | high
AGENT_EFFORT=medium


# -----------------------------------------------------------------------------
# 4. WHATSAPP
#
#    Two transports, one switch. `meta` is the official Cloud API and needs a
#    verified business; `evolution` drives an ordinary WhatsApp account through
#    a self-hosted server — free and instant, but unofficial.
# -----------------------------------------------------------------------------

# meta | evolution
WHATSAPP_PROVIDER=meta

# --- Official Meta Cloud API ---
# developers.facebook.com → your app → WhatsApp → API Setup

# [REQUIRED for meta] The number that sends and receives.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# [REQUIRED for meta] A permanent System User token with
# whatsapp_business_messaging and whatsapp_business_management.
# WHATSAPP_ACCESS_TOKEN falls back to META_SYSTEM_USER_TOKEN, so on a
# single-app install you only need to set the META_ one.
META_SYSTEM_USER_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# [REQUIRED for meta] Verifies the signature on every inbound webhook.
# App secret belongs to the Meta APP, so WHATSAPP_APP_SECRET falls back to
# META_APP_SECRET — set one of them.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_APP_SECRET=

# [REQUIRED for meta] A random string YOU invent. You paste the same value into
# Meta's webhook setup and it is echoed back once to prove the endpoint is
# yours. It is NOT an access token — never put a real token here, because this
# value travels in a query string and ends up in server logs.
WHATSAPP_VERIFY_TOKEN=

WHATSAPP_API_VERSION=v21.0
META_GRAPH_VERSION=v21.0

# --- Evolution (unofficial, interim) ---
# Setting the first three lets this console SEND as a human (take over a chat).
# It does not make this app answer customers — see EVOLUTION_INBOUND below.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=
# Who auto-replies. Exactly ONE deployment per WhatsApp number may set this to
# `enabled`; today that is the VPS agent, not this dashboard. Two responders on
# one number means every customer gets two different answers, so /api/osf/
# evolution refuses inbound with 410 unless this is explicitly turned on.
EVOLUTION_INBOUND=
# Personal-number guard rails. With a trigger word set the agent answers ONLY
# messages whose first word matches, so private chats on the same handset are
# never touched. Leave both blank on a dedicated business SIM.
EVOLUTION_TRIGGER_WORD=villa
EVOLUTION_IGNORE_BEFORE=
EVOLUTION_SELF_NUMBER=

# [NEEDED] Where a hot lead or a handoff request is sent. Without this the
# request is recorded in the CRM and nobody is paged.
SALES_TEAM_WHATSAPP=
SALES_TEAM_NAME=


# -----------------------------------------------------------------------------
# 5. VOICE CALLS — Bolna
# -----------------------------------------------------------------------------

BOLNA_API_KEY=
BOLNA_AGENT_ID=
# [NEEDED] Shared secret on the call webhook, so only Bolna can post
# transcripts. A finished call writes a lead and can trigger a WhatsApp
# follow-up, so an open endpoint is an open door.
VOICE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# 6. SOCIAL PUBLISHING
#    Only needed for the channels you actually post to.
# -----------------------------------------------------------------------------

# live enables real publishing; anything else makes every post fail loudly
# rather than pretending to succeed.
PLATFORM_DRIVER=mock

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_URN=
# LinkedIn retires each monthly API version after about a year. Bump this when
# calls start returning 426.
LINKEDIN_API_VERSION=202510

INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GBP_LANGUAGE_CODE=en

UPLOAD_POST_API_KEY=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY


# -----------------------------------------------------------------------------
# 7. SECRETS THE APP SIGNS WITH
#    Generate each with:  openssl rand -base64 32
# -----------------------------------------------------------------------------

# [REQUIRED] Protects the publish queue endpoint. Without it the queue can be
# driven by anyone who finds the URL.
WORKER_SECRET=

# [NEEDED] Authorises scheduled jobs (follow-ups, outbound).
CRON_SECRET=

# [NEEDED] Signs ops sessions and document download links.
OPS_SESSION_SECRET=
OPS_DOCUMENT_SECRET=


# -----------------------------------------------------------------------------
# 8. SIGN-IN
# -----------------------------------------------------------------------------

# supabase | legacy
AUTH_MODE=supabase
# [OPTIONAL] Comma-separated domains allowed to sign in, e.g. glentree.com
AUTH_ALLOWED_EMAIL_DOMAINS=
GLENTREE_EMAIL_DOMAIN=


# -----------------------------------------------------------------------------
# 9. NOTIFICATIONS
# -----------------------------------------------------------------------------

RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_EMAILS=


# -----------------------------------------------------------------------------
# 10. CONTENT AND PATHS
# -----------------------------------------------------------------------------

# Public links the agent may send a customer. Both must be HTTPS and must
# resolve publicly — the agent refuses to send anything it cannot verify.
BROCHURE_URL=
PROJECT_MAPS_URL=

KB_FACTS_PATH=
# Local file storage. On Vercel these must point at /tmp, which is the only
# writable location there.
OPS_DATA_DIR=.data
OPS_DOCUMENT_DIR=.data/documents

# Shows the names of third-party vendors on the settings screen. Leave unset on
# a client deployment — the product is white-labelled.
SHOW_VENDOR_DIAGNOSTICS=


# -----------------------------------------------------------------------------
# 11. ODDS AND ENDS
#     Everything here is optional; the feature simply stays off without it.
# -----------------------------------------------------------------------------

# Alias some older code paths still read instead of NEXT_PUBLIC_APP_URL.
PUBLIC_BASE_URL=

GOOGLE_SHEETS_API_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# n8n, if you drive the video pipeline from it.
N8N_VIDEO_FORM_URL=
N8N_WEBHOOK_SECRET=

UPLOAD_POST_USER=
TIKTOK_CLIENT_KEY=
X_CLIENT_ID=
