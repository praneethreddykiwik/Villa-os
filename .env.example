# ---------------------------------------------------------------------------
# ORBIT SOCIAL — environment
# Everything works with zero keys (DRIVER=mock). Fill these in to go live.
# ---------------------------------------------------------------------------

# mock  = deterministic simulated platform data (default, no keys needed)
# live  = real HTTP calls to the platform APIs using the tokens below
PLATFORM_DRIVER=mock

# --- Anthropic (AI captions, reply drafting, strategy narratives) -----------
# Without this the AI engines still run: they fall back to the deterministic
# rule/statistics engine, they just lose the natural-language polish.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Meta (Instagram + Facebook Pages + Meta Ads) ---------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000

# --- Google Ads -------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Business Profile (reviews, local insights) ----------------------
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Other networks ---------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
TIKTOK_ACCESS_TOKEN=
X_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# --- Worker -----------------------------------------------------------------
# Shared secret so only your cron/worker can trigger the publish tick.
WORKER_SECRET=dev-secret

# --- WhatsApp Business (Cloud API) ------------------------------------------
# Webhook: point Meta at POST /api/webhooks/whatsapp and use the verify token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify

# --- OAuth client credentials for the Connect flow --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
