{
  "name": "orbit-social",
  "version": "1.0.0",
  "private": true,
  "description": "Universal social media, ads and local-presence command center",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "typecheck": "tsc --noEmit",
    "tick": "curl -s -X POST \"http://localhost:4321/api/publish/tick?secret=${WORKER_SECRET:-dev-secret}\"",
    "reseed": "rm -f .data/db.json && echo 'database reset - it rebuilds on the next request'"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.2.1",
    "lucide-react": "0.544.0",
    "date-fns": "4.1.0",
    "clsx": "2.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "tailwindcss": "4.1.13",
    "@tailwindcss/postcss": "4.1.13"
  }
}
