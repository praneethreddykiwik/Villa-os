node_modules
# Every Next build output, whatever the dist directory is called.
# .next and .next-build were listed by name, so .next-prod was not ignored
# and a 234MB webpack cache went into a commit.
.next*
.data
.env
.env.local
*.tsbuildinfo
next-env.d.ts
media/renders
.test-build
.private
.provisioned-credentials.txt
.DS_Store
.security-audit/
.claude/
_e2e.mjs

# Timestamped .env backups taken before a live config change.
.env.bak.*
.env.recovered
.env.template-blank
.env.*
!.env.example

# Launch-video artifacts: a 10MB mp4 and its frames. Reproducible from
# brag-output/work, and not something a clone needs.
brag-output/

# Internal: holds the staff account roster and security findings. Never publish.
TECHNICAL-HANDOFF.md
